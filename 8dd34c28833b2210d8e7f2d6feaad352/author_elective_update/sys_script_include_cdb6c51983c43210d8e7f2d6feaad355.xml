        <description/>
        <mobile_callable>false</mobile_callable>
        <name>SharkflixReviewFilter</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var SharkflixReviewFilter = Class.create();
SharkflixReviewFilter.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

    getReviewedMedia: function() {
        var reviewedMedia = [];
        var grReview = new GlideRecord('x_683127_sharkflix_review');
        grReview.addQuery('media', '!=', ''); // Garante que o campo de mídia não está vazio
        grReview.query();

        while (grReview.next()) {
            reviewedMedia.push(grReview.getValue('media'));
        }

        return reviewedMedia.join(',');
    },

    type: 'SharkflixReviewFilter'
});]]></script>
